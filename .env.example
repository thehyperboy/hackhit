# ==============================================================================
# HackhIt — Supabase Environment Configuration (Example)
# ==============================================================================
# Copy this file to `.env.local` and substitute your actual Supabase credentials.
#
# Where to obtain these values:
# 1. Log in to your Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your HackhIt project.
# 3. Go to "Project Settings" (gear icon) -> "API".
# 4. Under "Project URL", copy the URL value -> VITE_SUPABASE_URL
# 5. Under "Project API keys", copy the "anon" / "publishable" key -> VITE_SUPABASE_PUBLISHABLE_KEY
#
# Security Notice:
# - NEVER expose your `service_role` secret key in frontend code or .env files.
# - ONLY use the public `anon` / publishable key in Vite client-side applications.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
